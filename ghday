def gh(args, inp=None):
    r = subprocess.run(["gh", *args], capture_output=True, text=True, input=inp)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "gh failed")
    return json.loads(r.stdout)


def graphql(query, **vars):
    args = ["api", "graphql", "-f", f"query={query}"]
    for k, v in vars.items():
        if v is not None:
            args += ["-f", f"{k}={v}"]
    out = gh(args)
    if out.get("errors") and not out.get("data"):
        raise RuntimeError(out["errors"][0].get("message"))
    return out["data"]


def search_all(q):
    nodes, after = [], None
    while True:
        s = graphql(SEARCH_PAGE, q=q, after=after)["search"]
        nodes += [n for n in s["nodes"] if n]
        if not s["pageInfo"]["hasNextPage"] or len(nodes) >= 1000:
            return nodes
        after = s["pageInfo"]["endCursor"]


def ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")) if s else None


def iso(d):
    return d.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def ago(d, now):
    if not d:
        return ""
    s = (now - d).total_seconds()
    if s < 3600:
        return f"{max(1, int(s // 60))} min"
    if s < 86400:
        return f"{int(s // 3600)} h"
    days = int(s // 86400)
    return f"{days} d" if days < 60 else f"{days // 30} mo"


def visit_threshold(now):
    # Reloads within 30 minutes count as the same visit, so "new" marks survive a refresh.
    try:
        st = json.loads(STATE.read_text())
    except (OSError, ValueError):
        st = {}
    last = ts(st.get("last"))
    prev = ts(st.get("prev")) or now - timedelta(days=1)
    if not last or now - last > timedelta(minutes=30):
        prev = last or prev
        st = {"prev": iso(prev), "last": iso(now)}
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(json.dumps(st))
    return prev


def human(node):
    a = node.get("author") or {}
    return a.get("__typename") != "Bot" and not (a.get("login") or "").endswith("[bot]")


def other_activity(item, me):
    """Latest comment or review by a human other than me, and my own latest activity."""
    evts = [(ts(c["createdAt"]), c["author"]["login"], c["url"], "comment")
            for c in item["comments"]["nodes"] if c.get("author") and human(c)]
    for r in (item.get("reviews") or {}).get("nodes", []):
        # An approval asks nothing back, so it never counts as waiting for my answer.
        if r.get("author") and r.get("submittedAt") and human(r) and r.get("state") != "APPROVED":
            evts.append((ts(r["submittedAt"]), r["author"]["login"], r["url"], "review"))
    mine = [e[0] for e in evts if e[1] == me]
    if item.get("author", {}).get("login") == me:
        c = item["commits"]["nodes"]
        if c:
            mine.append(ts(c[0]["commit"]["committedDate"]))
    others = sorted((e for e in evts if e[1] != me), key=lambda e: e[0])
    return (others[-1] if others else None), (max(mine) if mine else None)


def ci_state(pr):
    c = pr["commits"]["nodes"]
    roll = c[0]["commit"]["statusCheckRollup"] if c else None
    return roll["state"] if roll else None


def analyse(data, me, since, now):
    todo = []

    def add(group, item, reason, when):
        todo.append({"group": group, "item": item, "reason": reason,
                     "when": when, "new": bool(when and when > since)})

    for pr in data["reviewReq"]["nodes"]:
        req = [ts(e["createdAt"]) for e in pr["timelineItems"]["nodes"] if e]
        when = max(req) if req else ts(pr["updatedAt"])
        pr["_req"] = when
        add("review", pr, f"requested by {pr['author']['login']}", when)

    for pr in data["mine"]["nodes"]:
        other, mine_t = other_activity(pr, me)
        ci = ci_state(pr)
        pr["_ci"], pr["_other"] = ci, other
        if pr["reviewDecision"] == "CHANGES_REQUESTED":
            add("reply", pr, "changes requested", ts(pr["updatedAt"]))
        elif other and (not mine_t or other[0] > mine_t):
            add("reply", pr, f"{other[3]} from {other[1]}", other[0])
        if ci in ("FAILURE", "ERROR"):
            add("fix", pr, "CI failing", ts(pr["commits"]["nodes"][0]["commit"]["committedDate"]))
        if pr["mergeable"] == "CONFLICTING":
            add("fix", pr, "merge conflict", ts(pr["updatedAt"]))
        answered = not (other and (not mine_t or other[0] > mine_t))
        if (answered and pr["reviewDecision"] == "APPROVED" and not pr["isDraft"]
                and ci in (None, "SUCCESS") and pr["mergeable"] != "CONFLICTING"):
            add("merge", pr, "approved, CI green", ts(pr["updatedAt"]))

    for pr in data["reviewed"]["nodes"]:
        my_reviews = [ts(r["submittedAt"]) for r in pr["reviews"]["nodes"]
                      if r.get("author") and r["author"]["login"] == me and r.get("submittedAt")]
        c = pr["commits"]["nodes"]
        last_commit = ts(c[0]["commit"]["committedDate"]) if c else None
        mine = sorted((r for r in pr["reviews"]["nodes"] if r.get("author") and r["author"]["login"] == me
                       and r.get("submittedAt")), key=lambda r: r["submittedAt"])
        # My approval still stands, so new commits do not need me again; a re-request lands in reviewReq.
        still_ok = mine and mine[-1]["state"] == "APPROVED" and pr["reviewDecision"] == "APPROVED"
        if my_reviews and last_commit and last_commit > max(my_reviews) and not still_ok:
            add("review", pr, f"new commits from {pr['author']['login']} since your review", last_commit)

    for iss in data["assigned"]["nodes"]:
        evts = [ts(e["createdAt"]) for e in iss["timelineItems"]["nodes"]
                if e and (e.get("assignee") or {}).get("login") == me]
        iss["_assigned"] = max(evts) if evts else None
        other, mine_t = other_activity(iss, me)
        iss["_other"] = other
        if iss["_assigned"] and now - iss["_assigned"] < timedelta(days=3):
            add("new", iss, "assigned to you", iss["_assigned"])
        if other and mine_t and other[0] > mine_t:
            add("reply", iss, f"{other[1]} commented after you", other[0])

    data["_testing"] = []
    for iss in data["qa"]["nodes"]:
        tl = iss["timelineItems"]["nodes"]
        was = any(e["__typename"] in ("AssignedEvent", "UnassignedEvent")
                  and (e.get("assignee") or {}).get("login") == me for e in tl)
        my_pr = any(e["__typename"] == "CrossReferencedEvent"
                    and ((e.get("source") or {}).get("author") or {}).get("login") == me for e in tl)
        if not (was or my_pr):
            continue
        names = {l["name"] for l in iss["labels"]["nodes"]}
        state = "verified" if "verified" in names else "testing"
        ev = [e for e in tl if e["__typename"] == "LabeledEvent" and e["label"]["name"] == state]
        iss["_since"] = ts(ev[-1]["createdAt"]) if ev else ts(iss["updatedAt"])
        iss["_by"] = ((ev[-1].get("actor") or {}).get("login") if ev else None)
        repos = sorted({short_repo(e["source"]["repository"]["nameWithOwner"]) for e in tl
                        if e["__typename"] == "CrossReferencedEvent" and e.get("source", {}).get("merged")
                        and (e["source"].get("author") or {}).get("login") == me})
        if state == "verified":
            why = f"verified by {iss['_by']}" if iss["_by"] else "verified"
            add("release", iss, why + (f", release {', '.join(repos)}" if repos else ""), iss["_since"])
        else:
            data["_testing"].append(iss)
            who = ", ".join(a["login"] for a in iss["assignees"]["nodes"]) or "nobody"
            add("testing", iss, f"tested by {who}", iss["_since"])

    for iss in data["created"]["nodes"]:
        if iss["repository"]["nameWithOwner"] == QA_REPO and not iss["assignees"]["nodes"]:
            add("fix", iss, "nobody assigned, it will skip the QA flow", ts(iss["updatedAt"]))

    todo.sort(key=lambda t: -(t["when"] or now).timestamp())
    groups = {g[0]: [] for g in GROUPS}
    seen = {}
    for t in todo:
        key = (t["group"], t["item"]["url"])
        if key in seen:
            seen[key]["reason"] += ", " + t["reason"]
            seen[key]["new"] = seen[key]["new"] or t["new"]
            continue
        seen[key] = t
        groups[t["group"]].append(t)
    return groups


