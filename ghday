def cached_stats(now):
    # History moves slowly and costs most of the API time, so it is refreshed at most hourly.
    try:
        c = json.loads(STATS_CACHE.read_text())
        if now - ts(c["at"]) < STATS_TTL:
            return c
    except (OSError, ValueError, KeyError):
        pass
    st = stats(now)
    c = {"at": iso(now), "html": render_stats(st), "week_merged": st["cur_w"]["merged"]}
    STATS_CACHE.parent.mkdir(parents=True, exist_ok=True)
    STATS_CACHE.write_text(json.dumps(c))
    return c


DAILY_QUERY = """
query($merged: String!, $opened: String!, $reviewed: String!) {
  merged: search(type: ISSUE, first: 100, query: $merged) { nodes { ... on PullRequest { number title url repository { nameWithOwner } } } }
  opened: search(type: ISSUE, first: 100, query: $opened) { nodes { ... on PullRequest { number title url isDraft mergedAt repository { nameWithOwner } } } }
  reviewed: search(type: ISSUE, first: 100, query: $reviewed) {
    nodes { ... on PullRequest { number title url repository { nameWithOwner }
      reviews(last: 50) { nodes { author { login } state submittedAt } } } }
  }
}
"""
EN_DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
REFRESH = 300
REFRESH_CHOICES = (60, 300, 600, 900, 1800, 3600)
REFRESH_FILE = STATE.with_name("refresh.json")


def load_refresh():
    try:
        v = int(json.loads(REFRESH_FILE.read_text()))
    except (OSError, ValueError, TypeError):
        return REFRESH
    return v if v in REFRESH_CHOICES else REFRESH


def refresh_select(every):
    opts = "".join(f'<option value="{v}"{" selected" if v == every else ""}>{v // 60} min</option>'
                   for v in REFRESH_CHOICES)
    return (f'<div class="ctl"><label>Refresh every <select id="every">{opts}</select></label>'
            f'<button id="now" type="button">Refresh now</button></div>')


def previous_workday(local):
    d = local.replace(hour=0, minute=0, second=0, microsecond=0) - timedelta(days=1)
    while d.weekday() >= 5:
        d -= timedelta(days=1)
    return d, d + timedelta(days=1)


def daily_data(me, now):
    a, b = previous_workday(now.astimezone())
    day = a.strftime("%Y-%m-%d")
    d = graphql(DAILY_QUERY, merged=f"is:pr author:@me merged:{day}", opened=f"is:pr author:@me created:{day}",
                reviewed=f"is:pr reviewed-by:@me -author:@me updated:>={day}")
    reviewed = []
    for pr in d["reviewed"]["nodes"]:
        mine = [r["state"] for r in pr["reviews"]["nodes"]
                if (r.get("author") or {}).get("login") == me and r.get("submittedAt") and a <= ts(r["submittedAt"]) < b]
        if mine:
            pr["_state"] = "APPROVED" if "APPROVED" in mine else mine[-1]
            reviewed.append(pr)
    merged_urls = {p["url"] for p in d["merged"]["nodes"]}
    opened = [p for p in d["opened"]["nodes"] if p["url"] not in merged_urls]
    return {"start": iso(a), "merged": d["merged"]["nodes"], "opened": opened, "reviewed": reviewed}


def fetch():
    now = datetime.now(timezone.utc)
    with ThreadPoolExecutor(3) as ex:
        f_data, f_notes, f_st = ex.submit(graphql, NOW_QUERY), ex.submit(notifications), ex.submit(cached_stats, now)
        data, notes, st = f_data.result(), f_notes.result(), f_st.result()
    daily = daily_data(data["viewer"]["login"], now)
    return {"at": now, "data": data, "notes": notes, "stats": st, "daily": daily}


def pr_ref(p):
    return f'{short_repo(p["repository"]["nameWithOwner"])}#{p["number"]}'


def collapse(prs):
    """Group sweeps that land the same title in many repos into one line."""
    by_title = defaultdict(list)
    for p in prs:
        by_title[p["title"]].append(p)
    lines = []
    for title, ps in by_title.items():
        if len(ps) > 2:
            lines.append(f"{title} ({len(ps)} repos)")
        else:
            lines.append(f"{title} ({', '.join(pr_ref(p) for p in ps)})")
    return lines


def daily_text(f, groups, now):
    data, d = f["data"], f["daily"]
    start = ts(d["start"]).astimezone()
    label = "Friday" if now.astimezone().weekday() == 0 else "Yesterday"
    y = []
    y += [f"Merged: {l}" for l in collapse(d["merged"])]
    y += [f"Opened: {l}" for l in collapse(d["opened"])]
    states = {"APPROVED": "approved", "CHANGES_REQUESTED": "asked for changes", "COMMENTED": "commented"}
    y += [f"Reviewed {pr_ref(p)}, {states.get(p['_state'], 'reviewed')}: {p['title']}" for p in d["reviewed"]]
    a, b = ts(d["start"]), ts(d["start"]) + timedelta(days=1)
    for iss in data["qa"]["nodes"]:
        if iss.get("_since") and a <= iss["_since"] < b:
            st = "verified" if any(l["name"] == "verified" for l in iss["labels"]["nodes"]) else "moved to testing"
            y.append(f"QA {st}: dev#{iss['number']} {iss['title']}")

    t = []
    for g in groups["release"]:
        it = g["item"]
        rep = g["reason"].split("release ", 1)[1] if "release " in g["reason"] else "the package"
        t.append(f"Release {rep} for dev#{it['number']} {it['title']}")
    for g in groups["reply"]:
        t.append(f"Answer {pr_ref(g['item'])}: {g['item']['title']}")
    for g in groups["fix"]:
        t.append(f"Fix {'CI' if 'CI' in g['reason'] else 'conflict'} on {pr_ref(g['item'])}: {g['item']['title']}")
    for g in groups["merge"]:
        t.append(f"Merge {pr_ref(g['item'])}: {g['item']['title']}")
    for g in groups["review"]:
        t.append(f"Review {pr_ref(g['item'])}: {g['item']['title']}")
    for g in groups["new"]:
        t.append(f"Start dev#{g['item']['number']}: {g['item']['title']}")

    shown = {x["item"]["url"] for v in groups.values() for x in v}
    waiting = [p for p in data["mine"]["nodes"] if p["url"] not in my_move(groups) and not p["isDraft"]]
    blk = []
    if waiting:
        oldest = min(waiting, key=lambda p: ts(p["createdAt"]))
        blk.append(f"{len(waiting)} PRs waiting for review, oldest {ago(ts(oldest['createdAt']), now).replace(' d', ' days').replace(' h', 'h')}: {pr_ref(oldest)}")
    if data["_testing"]:
        blk.append(f"{len(data['_testing'])} issues in QA testing: " + ", ".join(f"dev#{i['number']}" for i in data["_testing"]))

    linked = d["merged"] + d["opened"] + d["reviewed"] + data["qa"]["nodes"] + waiting + data["_testing"] + \
        [x["item"] for v in groups.values() for x in v]
    links = {pr_ref(x): x["url"] for x in linked if x.get("url")}

    def section(title, lines, empty):
        return title + "\n" + ("\n".join(f"- {l}" for l in lines) if lines else f"- {empty}")

    return {"title_y": f"{label} ({EN_DAYS[start.weekday()]} {start.day})", "y": y, "t": t, "b": blk, "links": links,
            "text": "\n\n".join([section(f"{label}:", y, "nothing recorded on GitHub"),
                                 section("Today:", t, "continue current issues"),
                                 section("Blockers:", blk, "none")])}


def render_daily(dt):
    links = dt.get("links") or {}
    # Longest first so ns8-core#13 never matches inside ns8-core#1325.
    pat = re.compile(r"(?<![\w/-])(" + "|".join(re.escape(k) for k in sorted(links, key=len, reverse=True)) + r")(?!\d)") if links else None

    def linkify(line):
        line = e(line)
        return pat.sub(lambda m: f'<a href="{e(links[m.group(1)])}">{m.group(1)}</a>', line) if pat else line

    def block(title, lines, empty):
        lis = "".join(f"<li>{linkify(l)}</li>" for l in lines) or f'<li class="none">{empty}</li>'
        return f'<section class="dblock"><h3>{title}</h3><ul>{lis}</ul></section>'
    return (f'<div class="daily"><div class="dhead"><p class="h2note">Ready to paste in the daily channel. '
            f'"{e(dt["title_y"])}" covers the last working day.</p>'
            f'<button id="copy" type="button">Copy text</button></div>'
            f'<div class="dgrid">{block(e(dt["title_y"]), dt["y"], "nothing on GitHub")}'
            f'{block("Today", dt["t"], "nothing planned")}{block("Blockers", dt["b"], "none")}</div>'
            f'<textarea id="dtext" readonly hidden>{e(dt["text"])}</textarea></div>')


def render(f, since, live=False, every=REFRESH):
    now = datetime.now(timezone.utc)
    data = copy.deepcopy(f["data"])
    notes, st = f["notes"], f["stats"]
    me = data["viewer"]["login"]
    groups = analyse(data, me, since, now)
    hidden = apply_hidden(groups, now)
    dt = daily_text({**f, "data": data}, groups, now)
    local = now.astimezone()

    total = sum(len(v) for g, v in groups.items() if g != "testing")
    fresh = sum(1 for g, v in groups.items() if g != "testing" for t in v if t["new"])
    if total:
        lede = f"<b>{total} action{'s' if total > 1 else ''}</b> waiting for you"
        lede += f", {fresh} new" if fresh else ""
    else:
        lede = "Nothing waits for you"
    lede += f". Last visit {ago(since, now)} ago."
    shown = {t["item"]["url"] for v in groups.values() for t in v}
    mine = data["mine"]["nodes"]
    waiting = sum(1 for pr in mine if pr["url"] not in my_move(groups))
    fetched = f["at"].astimezone()
    foot = (f"Data from {fetched:%H:%M}, refreshed every {every // 60} min. The page reloads by itself."
            if live else f"Data from {fetched:%H:%M}. Run <code>ghday</code> again to refresh.")

    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>GitHub day</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>{CSS}</style></head><body data-live="{1 if live else 0}" data-every="{every}"><div class="wrap">
<div class="top"><div><h1>{DAYS[local.weekday()]}, {MONTHS[local.month - 1]} {local.day}</h1><p class="lede">{lede}</p></div>
<div class="tr-r">{refresh_select(every) if live else ""}<nav><button data-v="jour" aria-pressed="true">Today</button><button data-v="daily" aria-pressed="false">Daily</button><button data-v="stats" aria-pressed="false">Stats</button></nav></div></div>
<main data-view="jour">
{render_strip(groups)}
<div class="board"><div class="main-col">
{render_groups(groups, now, live, hidden, render_waiting(mine, my_move(groups), data["mine"]["issueCount"], now))}
</div><aside class="side-col">
<h2>My issues</h2><p class="h2note">{data["assigned"]["issueCount"]} assigned, newest first.</p>
{render_issues(data["assigned"]["nodes"], since, now)}
{render_follow(data, shown, now)}
{render_notes(notes, shown, now)}
</aside></div>
</main>
<main data-view="daily" hidden>{render_daily(dt)}</main>
<main data-view="stats" hidden>{st["html"]}<p class="note" style="margin-top:24px">Computed {ago(ts(st["at"]), now)} ago, at most once per hour.</p></main>
<footer>{foot} Account {e(me)}, through <code>gh</code>.</footer>
</div><script>{JS}</script></body></html>"""


def build():
    f = fetch()
    page = render(f, visit_threshold(f["at"]))
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(page)
    return page


HIDDEN = STATE.with_name("hidden.json")
HIDE_LOCK = threading.Lock()


def load_hidden():
    try:
        return json.loads(HIDDEN.read_text())
    except (OSError, ValueError):
        return {}


def save_hidden(h):
    HIDDEN.parent.mkdir(parents=True, exist_ok=True)
    HIDDEN.write_text(json.dumps(h))


def apply_hidden(groups, now):
    """Drop hidden or snoozed items, unless something happened on them after they were hidden."""
    h, count = load_hidden(), 0
    for g, items in groups.items():
        keep = []
        for t in items:
            rule = h.get(f"{g}|{t['item']['url']}")
            active = rule and (rule["until"] is None or ts(rule["until"]) > now)
            quiet = rule and (t["when"] is None or t["when"] <= ts(rule["seen"]))
            if active and quiet:
                count += 1
            else:
                keep.append(t)
        groups[g] = keep
    return count


def hide_item(key, seen, mode):
    local = datetime.now().astimezone()
    until = None
    if mode == "snooze":
        until = iso((local + timedelta(days=1)).replace(hour=7, minute=0, second=0, microsecond=0))
    with HIDE_LOCK:
        h = load_hidden()
        h[key] = {"until": until, "seen": seen or iso(datetime.now(timezone.utc))}
        save_hidden(h)


NOTIFY_STATE = STATE.with_name("notified.json")
NOTIFY_LABELS = {"release": "To release", "review": "To review", "reply": "To answer",
                 "fix": "To fix", "merge": "To merge", "new": "New issue"}


def notify_new(f):
    data = copy.deepcopy(f["data"])
    groups = analyse(data, data["viewer"]["login"], f["at"], f["at"])
    current = {f"{g}|{t['item']['url']}": t for g, v in groups.items() if g != "testing" for t in v}
    try:
        known = set(json.loads(NOTIFY_STATE.read_text()))
    except (OSError, ValueError):
        known = None
    NOTIFY_STATE.parent.mkdir(parents=True, exist_ok=True)
    NOTIFY_STATE.write_text(json.dumps(sorted(current)))
    # First run only records the baseline, so a restart does not replay every open item.
    if known is None:
        return
    for key in sorted(set(current) - known):
        t = current[key]
        g = key.split("|", 1)[0]
        urgency = "critical" if g == "release" else "normal"
        subprocess.run(["notify-send", "--app-name=GitHub", f"--urgency={urgency}", "--icon=dialog-information",
                        f"{NOTIFY_LABELS[g]} · {short_repo(t['item']['repository']['nameWithOwner'])}#{t['item']['number']}",
                        f"{t['item']['title']}\n{t['reason']}"], check=False)


def serve(port):
    cache = {"f": None, "err": None, "every": load_refresh()}
    lock = threading.Lock()
    wake = threading.Event()

    def refresh():
        try:
            f = fetch()
            with lock:
                cache["f"], cache["err"] = f, None
            notify_new(f)
        except Exception as ex:  # keep serving the last good data when GitHub or gh hiccups
            cache["err"] = str(ex)
            print(f"ghday: refresh failed: {ex}", file=sys.stderr, flush=True)

    def loop():
        while True:
            # A new interval wakes the loop so it applies now, not after the old delay.
            if wake.wait(cache["every"]):
                wake.clear()
                continue
            refresh()

    class H(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path not in ("/", "/index.html"):
                self.send_error(404)
                return
            with lock:
                f = cache["f"]
            if f is None:
                refresh()
                f = cache["f"]
            if f is None:
                body, code = f"<pre>ghday: {e(cache['err'] or 'no data')}</pre>".encode(), 500
            else:
                body, code = render(f, visit_threshold(datetime.now(timezone.utc)), live=True, every=cache["every"]).encode(), 200
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):
            try:
                n = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(n) or b"{}")
                if self.path == "/hide" and body.get("m") in ("hide", "snooze") and body.get("k"):
                    hide_item(str(body["k"]), body.get("w") or None, body["m"])
                elif self.path == "/refresh-every" and body.get("s") in REFRESH_CHOICES:
                    cache["every"] = body["s"]
                    REFRESH_FILE.parent.mkdir(parents=True, exist_ok=True)
                    REFRESH_FILE.write_text(json.dumps(body["s"]))
                    wake.set()
                elif self.path == "/refresh-now":
                    refresh()
                    wake.set()
                elif self.path == "/unhide-all":
                    with HIDE_LOCK:
                        save_hidden({})
                else:
                    self.send_error(400)
                    return
            except (ValueError, OSError):
                self.send_error(400)
                return
            self.send_response(204)
            self.end_headers()

        def log_message(self, *a):
            pass

    refresh()
    threading.Thread(target=loop, daemon=True).start()
    print(f"http://127.0.0.1:{port}/", flush=True)
    ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()


