def short_repo(r):
    return r.split("/", 1)[1] if r.startswith("NethServer/") else r


def ref(item):
    return f'<span class="ref">{e(short_repo(item["repository"]["nameWithOwner"]))}<i>#{item["number"]}</i></span>'


def flags(pr):
    out = []
    ci = pr.get("_ci") or ci_state(pr)
    if ci in ("FAILURE", "ERROR"):
        out.append('<span class="flag bad">CI rouge</span>')
    elif ci == "PENDING":
        out.append('<span class="flag">CI en cours</span>')
    if pr.get("mergeable") == "CONFLICTING":
        out.append('<span class="flag bad">conflit</span>')
    return "".join(out)


def render_strip(groups):
    cells = []
    for key, name, _ in GROUPS:
        n = len(groups[key])
        fresh = sum(1 for t in groups[key] if t["new"])
        sub = f'{fresh} new' if fresh else ("none" if not n else "&nbsp;")
        tag = "a" if n else "div"
        href = f' href="#g-{key}"' if n else ""
        cells.append(f'<{tag} class="cell g-{key}{" zero" if not n else ""}"{href}>'
                     f'<b>{n}</b><span>{name}</span><small>{sub}</small></{tag}>')
    return '<div class="strip">' + "".join(cells) + "</div>"


def render_groups(groups, now, live=False, hidden=0, tail=""):
    cards = []
    for key, name, hint in GROUPS:
        if key == "new" and tail:
            cards.append(tail)
            tail = ""
        items = groups[key]
        if not items:
            continue
        lis = "".join(
            f'<li{" class=new" if t["new"] else ""}><a class="t" href="{e(t["item"]["url"])}">{e(t["item"]["title"])}</a>'
            f'<div class="m">{ref(t["item"])}<span class="why">{e(t["reason"])}</span>'
            f'<span class="age">{ago(t["when"], now)}</span></div>'
            + (f'<div class="act" data-k="{e(key + "|" + t["item"]["url"])}" data-w="{iso(t["when"]) if t["when"] else ""}">'
               f'<button type="button" data-m="snooze">Tomorrow</button><button type="button" data-m="hide">Hide</button></div>'
               if live else "") + '</li>' for t in items)
        cards.append(f'<section class="card g-{key}" id="g-{key}"><header><h3>{name}</h3>'
                     f'<span class="n">{len(items)}</span></header><p class="hint">{hint}</p>'
                     f'<ul>{lis}</ul></section>')
    more = (f'<p class="hidden-note">{hidden} item{"s" if hidden > 1 else ""} hidden or snoozed. '
            f'{"They come" if hidden > 1 else "It comes"} back as soon as something new happens. <button type="button" id="unhide">Show all</button></p>'
            if hidden and live else "")
    if tail:
        cards.append(tail)
    if not cards:
        return '<p class="calm">Nothing waits for you. Good time to push a long-running issue.</p>' + more
    return '<div class="cards">' + "".join(cards) + "</div>" + more


def reviewers(pr):
    out = []
    for n in (pr.get("reviewRequests") or {}).get("nodes", []):
        r = n.get("requestedReviewer") or {}
        if r.get("login") or r.get("name"):
            out.append(r.get("login") or r.get("name"))
    return out


def waiting_since(pr):
    req = [ts(e["createdAt"]) for e in pr["timelineItems"]["nodes"] if e]
    return max(req) if req else ts(pr["createdAt"])


def blocker(pr, now):
    if pr["isDraft"]:
        return ""
    who = reviewers(pr)
    if who:
        return f'<span class="who">waiting for {e(", ".join(who))} for {ago(waiting_since(pr), now)}</span>'
    if pr["reviews"]["nodes"]:
        return '<span class="who">reviewed, no decision</span>'
    return f'<span class="who bad">no reviewer requested, opened {ago(ts(pr["createdAt"]), now)} ago</span>'


def my_move(groups):
    """PRs where the next step is mine. A CI failure or a conflict does not stop the reviewer."""
    return {x["item"]["url"] for g in ("reply", "merge") for x in groups.get(g, [])}


def render_waiting(prs, shown, total, now):
    """Open PRs with no action for me, grouped by who has to move next."""
    waiting = [p for p in prs if p["url"] not in shown]
    if not waiting:
        return ""
    by = defaultdict(list)
    for pr in waiting:
        if pr["isDraft"]:
            by["draft"].append(pr)
        elif reviewers(pr):
            for r in reviewers(pr):
                by[r].append(pr)
        elif pr["reviews"]["nodes"]:
            by["reviewed, no decision"].append(pr)
        else:
            by["no reviewer requested"].append(pr)
    groups = []
    for who, ps in sorted(by.items(), key=lambda kv: (-len(kv[1]), kv[0])):
        ps.sort(key=waiting_since)
        oldest = ago(waiting_since(ps[0]), now)
        bad = " bad" if who == "no reviewer requested" else ""
        rows = "".join(f'<li><a class="t" href="{e(p["url"])}">{e(p["title"])}</a><div class="m">{ref(p)}'
                       f'{flags(p)}<span class="age">{ago(waiting_since(p), now)}</span></div></li>' for p in ps)
        groups.append(f'<details class="wg{bad}"><summary><b>{e(who)}</b><span>{len(ps)} PR{"s" if len(ps) > 1 else ""}, '
                      f'oldest {oldest}</span></summary><ul>{rows}</ul></details>')
    return (f'<section class="card g-wait" id="g-wait"><header><h3>Waiting on others</h3><span class="n">{len(waiting)}</span></header>'
            f'<p class="hint">{len(waiting)} of your {total} open PRs, by who has to move next</p>{"".join(groups)}</section>')


def slug(name):
    return re.sub(r"[^a-z]+", "-", name.lower()).strip("-")


def render_issues(issues, since, now):
    if not issues:
        return '<p class="calm">No issue assigned.</p>'

    def arrived(it):
        return it.get("_assigned") or ts(it["createdAt"])

    def status(it):
        for n in (it.get("projectItems") or {}).get("nodes", []):
            if (n.get("fieldValueByName") or {}).get("name"):
                return n["fieldValueByName"]["name"]
        return None

    def row(it):
        st = status(it)
        kind = (it.get("issueType") or {}).get("name")
        tags = (f'<span class="ty ty-{slug(kind)}">{e(kind)}</span>' if kind else "") + \
               (f'<span class="st st-{slug(st)}">{e(st)}</span>' if st else "")
        # The status already says "Testing", the label would repeat it.
        keep = [l for l in it["labels"]["nodes"] if not st or l["name"].lower() != st.lower()][:2]
        labs = "".join(f'<span class="lab" style="--c:#{e(l["color"])}">{e(l["name"])}</span>' for l in keep)
        labs = tags + labs
        ms = f'<span class="ms">{e(it["milestone"]["title"])}</span>' if it.get("milestone") else ""
        stale = now - ts(it["updatedAt"]) > timedelta(days=STALE_DAYS)
        quiet = f'<span class="flag">quiet {ago(ts(it["updatedAt"]), now)}</span>' if stale else ""
        return (f'<li{" class=stale" if stale else ""}><a class="t" href="{e(it["url"])}">{e(it["title"])}</a>'
                f'<div class="m">{ref(it)}{labs}{ms}{quiet}<span class="age">assigned {ago(arrived(it), now)} ago</span></div></li>')

    return f'<ul class="rows">{"".join(row(x) for x in sorted(issues, key=arrived, reverse=True))}</ul>'


def render_follow(data, shown, now):
    seen = set(shown) | {i["url"] for i in data["assigned"]["nodes"]} | {i["url"] for i in data["_testing"]}
    items = {}
    for kind, nodes in (("opened by you", data["created"]["nodes"]), ("mentions you", data["mentioned"]["nodes"])):
        for it in nodes:
            if it["url"] not in seen:
                items.setdefault(it["url"], {**it, "_kind": set()})["_kind"].add(kind)
    if not items:
        return ""
    week = now - timedelta(days=7)
    repos = defaultdict(list)
    for it in items.values():
        repos[it["repository"]["nameWithOwner"]].append(it)
    order = sorted(repos.items(), key=lambda kv: -max(ts(i["updatedAt"]) for i in kv[1]).timestamp())
    recent = sum(1 for i in items.values() if ts(i["updatedAt"]) > week)
    blocks = []
    for repo, its in order:
        its.sort(key=lambda i: ts(i["updatedAt"]), reverse=True)
        rows = "".join(
            f'<li{" class=new" if ts(i["updatedAt"]) > week else ""}><a class="t" href="{e(i["url"])}">{e(i["title"])}</a>'
            f'<div class="m"><span class="ref"><i>#{i["number"]}</i></span><span class="why">{", ".join(sorted(i["_kind"]))}</span>'
            f'<span class="age">active {ago(ts(i["updatedAt"]), now)} ago</span></div></li>' for i in its)
        blocks.append(f'<h5>{e(short_repo(repo))} <span>{len(its)}</span></h5><ul class="rows">{rows}</ul>')
    return (f'<details class="notes follow"><summary>Following: issues you opened or that mention you <span>{len(items)}</span>'
            f'<small>{recent} active this week</small></summary>{"".join(blocks)}</details>')


def render_notes(notes, shown, now):
    keep = [n for n in notes if n["url"] not in shown
            and n["reason"] in ("mention", "team_mention", "comment", "author", "state_change", "assign")]
    if not keep:
        return ""
    rows = "".join(f'<li><a class="t" href="{e(n["url"])}">{e(n["title"])}</a><div class="m">'
                   f'<span class="ref">{e(short_repo(n["repo"]))}</span><span class="why">{e(REASONS.get(n["reason"], n["reason"]))}</span>'
                   f'<span class="age">{ago(n["when"], now)}</span></div></li>' for n in keep[:15])
    return (f'<details class="notes"><summary>Other unread notifications <span>{len(keep)}</span></summary>'
            f'<ul class="rows">{rows}</ul></details>')


def trend(cur, prev):
    if prev is None:
        return ""
    if cur == prev:
        return '<span class="tr">same</span>'
    up = cur > prev
    return f'<span class="tr {"up" if up else "down"}">{"▲" if up else "▼"} {abs(cur - prev)}</span>'


def tile(label, cur, prev, full, pname):
    same = f"same point: {prev}" if prev is not None else ""
    tot = f"full period: {full}" if full is not None else ""
    return (f'<div class="tile"><span class="tl">{label}</span><div class="tv"><b>{cur}</b>{trend(cur, prev)}</div>'
            f'<span class="tp">{" · ".join(x for x in (same, tot) if x)}</span></div>')


def dur(h):
    if h is None:
        return "–"
    if h < 1:
        return f"{max(1, round(h * 60))} min"
    if h < 48:
        return f"{h:.0f} h"
    return f"{h / 24:.1f} d"


def render_react(s):
    r = s["react"]
    cells = [("This week", r["w"]), ("Last week", r["pw"]),
             (f"This month, {s['month_name']}", r["m"]), (s["pmonth_name"], r["pm"])]
    tiles = "".join(
        f'<div class="tile"><span class="tl">{name}</span><div class="tv"><b>{dur(m)}</b></div>'
        f'<span class="tp">{n} review request{"s" if n != 1 else ""}</span></div>'
        for name, (m, n) in cells)
    return (f'<h3 class="sub">Your review response time</h3><p class="note">Median time between a review request '
            f'addressed to you and your first review after it.</p><div class="tiles react">{tiles}</div>')


def render_stats(s):
    w, pw = s["cur_w"], s["prev_w"]
    if w["merged"] >= pw["merged"]:
        head = f"Busy week: {w['merged']} PRs merged, against {pw['merged']} at the same point last week."
    else:
        head = f"Quieter week: {w['merged']} PRs merged, against {pw['merged']} at the same point last week."
    out = [f'<p class="finding">{e(head)}</p><div class="periods">']
    for title, cur, prev, full, pname in (
            ("This week", s["cur_w"], s["prev_w"], s["full_prev_w"], "last week"),
            (f"This month, {s['month_name']}", s["cur_m"], s["prev_m"], s["full_prev_m"], s["pmonth_name"])):
        out.append(f'<div class="period"><h3>{title}<small>compared with {pname}</small></h3><div class="tiles">'
                   + tile("PRs merged", cur["merged"], prev["merged"], full["merged"], pname)
                   + tile("Reviews done", cur["reviews"], None, full["reviews"], pname)
                   + tile("Issues delivered", cur["closed"], prev["closed"], full["closed"], pname)
                   + "</div></div>")
    out.append(f'</div>{render_react(s)}<p class="note" style="margin-top:12px">Issues delivered: {QA_REPO} issues closed as completed, '
               f'that you were assigned to at some point or that one of your PRs references.</p>')

    charts = []
    for key, name in (("merged", "PRs merged"), ("reviews", "Reviews done"), ("closed", "Issues delivered")):
        vals = [x[key] for x in s["series"]]
        top = max(vals) or 1
        avg = sum(vals[:-1]) / max(1, len(vals) - 1)
        bars = "".join(
            f'<div class="bar{" cur" if i == len(vals) - 1 else ""}" title="week of {x["week"]:%b %d}: {v}">'
            f'<span>{v or ""}</span><i style="height:{v / top * 100:.1f}%"></i></div>'
            for i, (x, v) in enumerate(zip(s["series"], vals)))
        avg_line = f'<div class="avg" style="bottom:{avg / top * 100:.1f}%"></div>' if avg else ""
        charts.append(f'<div class="chart"><h4>{name}<small>- - moyenne {avg:.1f} / sem.</small></h4><div class="bars">{bars}{avg_line}</div>'
                      f'<div class="axis"><span>week of {s["series"][0]["week"]:%b %d}</span><span>this week</span></div></div>')
    out.append(f'<div class="stats-grid"><section><h3 class="sub">Last {WEEKS} weeks</h3><div class="charts">' + "".join(charts) + "</div></section>")

    if s["repos"]:
        top_m = max(c["merged"] for _, c in s["repos"]) or 1
        top_r = max(c["reviews"] for _, c in s["repos"]) or 1
        rows = "".join(
            f'<tr><td>{e(short_repo(r))}</td>'
            f'<td><div class="hb"><i style="width:{c["merged"] / top_m * 100:.0f}%"></i><span>{c["merged"] or ""}</span></div></td>'
            f'<td><div class="hb rv"><i style="width:{c["reviews"] / top_r * 100:.0f}%"></i><span>{c["reviews"] or ""}</span></div></td>'
            f'<td class="num">{c["closed"] or ""}</td></tr>' for r, c in s["repos"][:15])
        lead = ""
        if s["lead_median"] is not None:
            h = s["lead_median"]
            lead = f' Median time from opening to merge: <b>{f"{h:.0f} h" if h < 48 else f"{h / 24:.1f} days"}</b>.'
        out.append(f'<section><h3 class="sub">Where your time went in {s["month_name"]}</h3>'
                   f'<p class="note">Repositories sorted by total activity. A delivered issue counts in the repository of your PR that references it.{lead}</p><div class="scroll"><table>'
                   f'<thead><tr><th>Repository</th><th>PRs merged</th><th>Reviews</th><th class="num">Issues delivered</th></tr></thead>'
                   f'<tbody>{rows}</tbody></table></div></section>')
    out.append("</div>")
    return "".join(out)


