def delivered(day, me):
    """Closed QA issues I was assigned to at some point or referenced from one of my PRs."""
    out, after = [], None
    while True:
        s = graphql(DELIVERED_PAGE, q=f"repo:{QA_REPO} is:issue is:closed reason:completed closed:>={day}", after=after)["search"]
        for n in s["nodes"]:
            tl = n["timelineItems"]["nodes"]
            was = any(e["__typename"] in ("AssignedEvent", "UnassignedEvent")
                      and (e.get("assignee") or {}).get("login") == me for e in tl)
            repos = {e["source"]["repository"]["nameWithOwner"] for e in tl
                     if e["__typename"] == "CrossReferencedEvent" and e.get("source", {}).get("repository")
                     and (e["source"].get("author") or {}).get("login") == me}
            if was or repos:
                out.append({"closedAt": n["closedAt"], "repos": sorted(repos)})
        if not s["pageInfo"]["hasNextPage"]:
            return out
        after = s["pageInfo"]["endCursor"]


TURNAROUND_PAGE = """
query($q: String!, $after: String, $me: String!) {
  search(type: ISSUE, first: 50, query: $q, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest {
      timelineItems(itemTypes: [REVIEW_REQUESTED_EVENT], last: 20) {
        nodes { ... on ReviewRequestedEvent { createdAt requestedReviewer { ... on User { login } } } }
      }
      reviews(author: $me, first: 50) { nodes { submittedAt } }
    } }
  }
}
"""


def turnaround(day, me):
    """Delay between each review request addressed to me and my first review after it."""
    out, after = [], None
    while True:
        s = graphql(TURNAROUND_PAGE, q=f"is:pr reviewed-by:@me -author:@me updated:>={day}", after=after, me=me)["search"]
        for pr in s["nodes"]:
            mine = sorted(ts(r["submittedAt"]) for r in pr["reviews"]["nodes"] if r.get("submittedAt"))
            for ev in pr["timelineItems"]["nodes"]:
                if not ev or (ev.get("requestedReviewer") or {}).get("login") != me:
                    continue
                asked = ts(ev["createdAt"])
                done = next((r for r in mine if r >= asked), None)
                if done:
                    out.append((done, (done - asked).total_seconds() / 3600))
        if not s["pageInfo"]["hasNextPage"]:
            return out
        after = s["pageInfo"]["endCursor"]


def stats(now):
    local = now.astimezone()
    week0 = (local - timedelta(days=local.weekday())).replace(hour=0, minute=0, second=0, microsecond=0)
    month0 = local.replace(day=1, hour=0, minute=0, second=0, microsecond=0)
    pmonth0 = (month0 - timedelta(days=1)).replace(day=1)
    start = min(week0 - timedelta(weeks=WEEKS - 1), pmonth0)
    day = start.strftime("%Y-%m-%d")

    me = graphql("query { viewer { login } }")["viewer"]["login"]
    with ThreadPoolExecutor(3) as ex:
        f_closed = ex.submit(delivered, day, me)
        f_turn = ex.submit(turnaround, pmonth0.strftime("%Y-%m-%d"), me)
        merged, opened = ex.map(search_all, [f"is:pr author:@me merged:>={day}", f"is:pr author:@me created:>={day}"])
        closed = f_closed.result()
        turn = f_turn.result()

    weeks = [week0 - timedelta(weeks=i) for i in range(WEEKS - 1, -1, -1)]
    ranges = {f"w{i}": (w, w + timedelta(weeks=1)) for i, w in enumerate(weeks)}
    ranges["m0"] = (month0, local)
    ranges["m1"] = (pmonth0, month0)
    parts = []
    for k, (a, b) in ranges.items():
        extra = ("pullRequestReviewContributionsByRepository(maxRepositories: 15) "
                 "{ repository { nameWithOwner } contributions { totalCount } }") if k == "m0" else ""
        parts.append(f'{k}: contributionsCollection(from: "{iso(a)}", to: "{iso(b)}") '
                     f"{{ totalPullRequestReviewContributions totalIssueContributions {extra} }}")
    contrib = graphql("query { viewer { " + " ".join(parts) + " } }")["viewer"]

    def count(nodes, field, a, b):
        return sum(1 for n in nodes if n.get(field) and a <= ts(n[field]) < b)

    series = []
    for i, w in enumerate(weeks):
        b = w + timedelta(weeks=1)
        series.append({"week": w, "merged": count(merged, "mergedAt", w, b),
                       "closed": count(closed, "closedAt", w, b),
                       "reviews": contrib[f"w{i}"]["totalPullRequestReviewContributions"]})

    def period(a, b, key):
        return {"merged": count(merged, "mergedAt", a, b), "closed": count(closed, "closedAt", a, b),
                "opened": count(opened, "createdAt", a, b),
                "reviews": contrib[key]["totalPullRequestReviewContributions"] if key else None}

    pweek = week0 - timedelta(weeks=1)
    elapsed = local - week0
    # Compare with the same number of days into last week, so Monday morning is not a "drop".
    cur_w = period(week0, local, f"w{WEEKS - 1}")
    prev_w = period(pweek, pweek + elapsed, None)
    full_prev_w = period(pweek, week0, f"w{WEEKS - 2}")
    m_elapsed = local - month0
    cur_m = period(month0, local, "m0")
    prev_m = period(pmonth0, min(pmonth0 + m_elapsed, month0), None)
    full_prev_m = period(pmonth0, month0, "m1")

    repos = defaultdict(lambda: Counter())
    for n in merged:
        if ts(n["mergedAt"]) >= month0:
            repos[n["repository"]["nameWithOwner"]]["merged"] += 1
    for n in closed:
        if ts(n["closedAt"]) >= month0:
            for r in n["repos"]:
                repos[r]["closed"] += 1
    for r in contrib["m0"]["pullRequestReviewContributionsByRepository"]:
        repos[r["repository"]["nameWithOwner"]]["reviews"] += r["contributions"]["totalCount"]

    lead = [(ts(n["mergedAt"]) - ts(n["createdAt"])).total_seconds() / 3600
            for n in merged if ts(n["mergedAt"]) >= month0]
    def med(a, b):
        vals = [h for d, h in turn if a <= d < b]
        return (statistics.median(vals), len(vals)) if vals else (None, 0)

    react = {"w": med(week0, local), "pw": med(pweek, week0), "m": med(month0, local), "pm": med(pmonth0, month0)}
    return {"react": react, "series": series, "cur_w": cur_w, "prev_w": prev_w, "full_prev_w": full_prev_w,
            "cur_m": cur_m, "prev_m": prev_m, "full_prev_m": full_prev_m,
            "repos": sorted(repos.items(), key=lambda kv: -sum(kv[1].values())),
            "lead_median": statistics.median(lead) if lead else None,
            "month_name": MONTHS[local.month - 1], "pmonth_name": MONTHS[pmonth0.month - 1]}


